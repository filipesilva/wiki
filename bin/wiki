#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["libzim", "html-to-markdown"]
# ///
"""Download, search and read local ZIM wikis.

wiki install                      add wiki to your PATH, in your shell's config
wiki skill [dir]                  add a skill for using wiki to a skills folder, by default Claude Code's ~/.claude/skills
wiki update [--check]             download the latest build of each wiki in wikis.txt, and delete older builds
                                  --check only lists the wikis with a newer build, and their download sizes
wiki sources                      regenerate sources.txt, the Kiwix folder for each ZIM name prefix
wiki list                         list wikis
wiki search <query> [-n N]        exact title matches, then ranked full-text search across all wikis, N hits (default 10)
                                  in:<prefix> in the query limits it to wikis whose name starts with prefix
wiki outline <wiki>/<path>        print an article's headings, with the size of each section
wiki get <wiki>/<path> [section]  print an article, or one section of it, as markdown
wiki open <wiki>[/<path>]         open the wiki, or an article in it, in the Kiwix app
wiki refs <wiki>/<path>           print the articles it links to
wiki _refs <wiki>/<path> [-n N]   print the articles that link to it, N of them (default 50), needs wiki index
wiki index [wiki]                 build the index for _refs, for one wiki or all that aren't indexed yet
                                  it runs in parallel, skips wikis already indexed, and continues where it stopped
"""
import contextlib
import hashlib
import html
import io
import json
import os
import posixpath
import re
import resource
import signal
import socket
import subprocess
import sys
import tempfile
import time
import traceback
from pathlib import Path
from urllib.parse import quote, unquote

ROOT = Path(__file__).resolve().parent.parent
KIWIX = "https://download.kiwix.org/zim"
# KIWIX itself isn't a file listing, so the folders are listed here.
FOLDERS = ["wikipedia", "wiktionary", "wikibooks", "wikiquote", "wikivoyage", "wikisource", "wikiversity", "gutenberg",
           "stack_exchange", "devdocs", "freecodecamp", "ifixit", "libretexts", "other", "ted", "mooc", "phet", "zimit",
           "vikidia", "videos"]


def install():
    bin_dir = Path(__file__).resolve().parent
    configs = {
        "bash": (Path.home() / ".bashrc", f'export PATH="{bin_dir}:$PATH"'),
        "zsh": (Path.home() / ".zshrc", f'export PATH="{bin_dir}:$PATH"'),
        "fish": (Path.home() / ".config/fish/config.fish", f"fish_add_path {bin_dir}"),
    }
    shell = Path(os.environ.get("SHELL", "")).name
    if shell not in configs:
        sys.exit(f"unsupported shell: {shell or 'unknown'}")
    config, line = configs[shell]
    if config.exists() and line in config.read_text():
        print(f"already in {config}")
    else:
        config.parent.mkdir(parents=True, exist_ok=True)
        with config.open("a") as f:
            f.write(f"\n{line}\n")
        print(f"added to {config}, restart your shell or source it")


SKILL = """---
name: wiki
description: Search and read local offline wikis, like Wikipedia, Wiktionary, Stack Exchange and devdocs, with the wiki CLI. Use for reference facts, definitions, and library or tool docs, before searching the web.
---

Local copies of Kiwix wikis, read with the CLI at `WIKI`, written `wiki` below. Run `wiki list` to see which wikis there are.

Articles go by `<wiki>/<path>` refs, e.g. `wikipedia/Ray_Charles`. Pass them on as printed, in single quotes, since paths can have `( ) ' &`, e.g. `wiki outline 'wikipedia/Python_(programming_language)'`.

- `wiki search <query> [-n N]`: exact title matches first, then ranked full-text hits, 10 by default. Add `in:<prefix>` to the query to search only some wikis, e.g. `in:wikipedia` or `in:devdocs_python`.
- `wiki outline <ref>`: the article's headings, with the size of each section.
- `wiki get <ref> [section]`: the article as markdown, or only the section whose heading matches.
- `wiki refs <ref>`: the articles it links to.
- `wiki _refs <ref> [-n N]`: the articles that link to it, if the wiki was indexed with `wiki index <wiki>`.

Long articles cost a lot of context, so run `outline` first and `get` the sections you need.
The wikis are snapshots, so check dates for recent events, and search the web when the wikis don't have it.
"""


def skill(skills=None):
    claude = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
    path = Path(skills).expanduser() / "wiki/SKILL.md" if skills else claude / "skills/wiki/SKILL.md"
    existed = path.exists()
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(SKILL.replace("WIKI", str(Path(__file__).resolve())))
    print(f"{'updated' if existed else 'added'} {path}")


def listing(folder):
    """{zim file: size} for a Kiwix folder, e.g. {"wikipedia_en_all_nopic_2026-06.zim": "49G"}."""
    import urllib.request

    with urllib.request.urlopen(f"{KIWIX}/{folder}/", timeout=60) as r:
        return dict(re.findall(r'href="([^"/?]+\.zim)">[^<]*</a>\s+\S+\s+\S+\s+(\S+)', r.read().decode()))


def sources():
    lines = ["# <zim name prefix> <kiwix folder>, generated by wiki sources"]
    for folder in FOLDERS:
        lines += [f"{prefix} {folder}" for prefix in sorted({f.split("_")[0] for f in listing(folder)})]
    (ROOT / "sources.txt").write_text("\n".join(lines) + "\n")
    print(f"{len(lines) - 1} prefixes in sources.txt")


def manifest():
    """The columns of each wikis.txt line, skipping blanks and comments."""
    path = ROOT / "wikis.txt"
    lines = path.read_text().splitlines() if path.exists() else []
    return [line.split() for line in lines if line.strip() and not line.lstrip().startswith("#")]


def pattern_re(pattern):
    """A wikis.txt name pattern as a regex, with * as a group."""
    return re.escape(pattern).replace(r"\*", "(.*)")


def build_date(zim):
    return Path(zim).stem.rsplit("_", 1)[1]


def update(check=False):
    if not (ROOT / "wikis.txt").exists():
        sys.exit("no wikis.txt, start with: cp wikis.example.txt wikis.txt")
    patterns = [columns[0] for columns in manifest()]
    folders = dict(line.split() for line in (ROOT / "sources.txt").read_text().splitlines() if not line.startswith("#"))
    zim, listings, outdated, wikis_seen = ROOT / "zim", {}, 0, 0
    zim.mkdir(exist_ok=True)
    for pattern in patterns:
        if (folder := folders.get(pattern.split("_")[0])) is None:
            sys.exit(f"no Kiwix folder for {pattern} in sources.txt")
        if folder not in listings:
            listings[folder] = listing(folder)
        regex = re.compile(pattern_re(pattern) + r"_\d{4}-\d{2}\.zim")
        latest = {full_name(Path(f)): f for f in sorted(listings[folder]) if regex.fullmatch(f)}
        if not latest:
            sys.exit(f"no builds found for {pattern}")
        for base, file in latest.items():
            target = zim / file
            wikis_seen += 1
            if check:
                if not target.exists():
                    outdated += 1
                    current = sorted(build_date(p) for p in zim.glob(f"{base}_*.zim") if full_name(p) == base)
                    change = f"{current[-1]} -> {build_date(file)}" if current else f"not downloaded, {build_date(file)}"
                    print(f"{base}  {change}, {listings[folder][file]}")
                continue
            if target.exists():
                print(f"{file} is up to date")
                continue
            print(f"downloading {file}")
            part = zim / f"{file}.part"
            if subprocess.run(["curl", "-fL", "-#", "-C", "-", "-o", part, f"{KIWIX}/{folder}/{file}"]).returncode:
                sys.exit(f"download of {file} failed, run wiki update again to resume")
            part.rename(target)
            for old in zim.glob(f"{base}_*.zim"):
                if old != target and full_name(old) == base:
                    for stale in (old, index_path(old), build_path(old)):
                        if stale.exists():
                            stale.unlink()
                            print(f"removed {stale.name}")
    if check:
        print(f"{outdated} of {wikis_seen} wikis have a newer build" + (", get them with: wiki update" if outdated else ""))


def aliases():
    """(regex, alias) for each wikis.txt line with a short name in its second column."""
    return [(re.compile(pattern_re(columns[0]) + "$"), columns[1]) for columns in manifest() if len(columns) == 2]


def short_name(full, rules):
    for regex, alias in rules:
        if m := regex.match(full):
            return alias.replace("*", m[1]) if m.groups() else alias
    return full


def full_name(path):
    return path.stem.rsplit("_", 1)[0]


def wikis():
    """ZIM paths by short name from wikis.txt, or by full name, e.g. wiktionary_en_all_nopic."""
    rules, found = aliases(), {}
    for p in sorted((ROOT / "zim").glob("*.zim")):
        name = short_name(full_name(p), rules)
        if name in found:
            sys.exit(f"{name} is the short name of {found[name].name} and {p.name}, fix wikis.txt")
        found[name] = p
    return found


ARCHIVES = {}


def open_archive(path):
    """The archive, kept open for later calls, or None with a warning when the file can't be read."""
    if path not in ARCHIVES:
        from libzim.reader import Archive

        try:
            ARCHIVES[path] = Archive(path)
        except RuntimeError as e:
            print(f"can't read {path.name}: {e}", file=sys.stderr)
            return None
    return ARCHIVES[path]


def find(wiki):
    """(name, archive) for a wiki's short or full name."""
    found = wikis()
    name = wiki if wiki in found else next((n for n, p in found.items() if full_name(p) == wiki), None)
    if name is None:
        sys.exit(f"no wiki named {wiki}, see: wiki list")
    if (archive := open_archive(found[name])) is None:
        sys.exit(1)
    return name, archive


def lookup(ref):
    """(name, archive, entry) for a <wiki>/<path> ref."""
    if "/" not in ref:
        sys.exit(f"refs look like <wiki>/<path>, e.g. wikipedia/{ref}, see: wiki search")
    wiki, path = ref.split("/", 1)
    name, archive = find(wiki)
    if not archive.has_entry_by_path(path):
        sys.exit(f"no article {path} in {name}")
    return name, archive, resolve(archive.get_entry_by_path(path))


def resolve(entry):
    while entry.is_redirect:
        entry = entry.get_redirect_entry()
    return entry


def text(fragment):
    return re.sub(r"\s+", " ", html.unescape(re.sub(r"<[^>]+>", "", fragment))).strip()


def first_sentence(entry):
    for p in re.findall(r"<p[^>]*>(.*?)</p>", bytes(entry.get_item().content).decode(errors="ignore"), re.S):
        if len(p := text(p)) > 20:
            m = re.match(r"(.{20,}?[.!?])(\s|$)", p)
            return (m[1] if m else p)[:300]
    return ""


def search(query, n):
    from libzim.search import Query, Searcher

    words = query.split()
    scopes = [w[3:] for w in words if w.startswith("in:")]
    q = " ".join(w for w in words if not w.startswith("in:"))
    paths = {
        name: p for name, p in wikis().items()
        if not scopes or any(n.startswith(s) for s in scopes for n in (name, full_name(p)))
    }
    if not paths:
        sys.exit(f"no wikis match {' '.join('in:' + s for s in scopes)}")
    scoped = {name: a for name, p in paths.items() if (a := open_archive(p))}

    hits = []
    for name, a in scoped.items():
        if len(hits) == n:
            break
        for title in dict.fromkeys([q, q[:1].upper() + q[1:], q.lower()]):
            if a.has_entry_by_title(title):
                entry = resolve(a.get_entry_by_title(title))
                hits.append((name, entry.path, entry.title, first_sentence(entry)))
                break

    seen = {(name, path) for name, path, _, _ in hits}
    names = {a.filename: name for name, a in scoped.items() if a.has_fulltext_index}
    if names and len(hits) < n:
        results = Searcher(*(scoped[name] for name in names.values())).search(Query().set_query(q))
        start = 0
        while len(hits) < n and (batch := list(results.get_results(start, n))):
            start += len(batch)
            for r in batch:
                key = (names[r.archive.filename], r.path)
                if r.path.startswith("Category:") or key in seen or len(hits) == n:
                    continue
                seen.add(key)
                hits.append((*key, r.title, text(r.snippet)))

    for name, path, title, snippet in hits[:n]:
        print(f"{name}/{path}  {title}\n  {snippet}")


def markdown(ref):
    import html_to_markdown

    _, _, entry = lookup(ref)
    options = html_to_markdown.ConversionOptions(strip_tags=["a"], skip_images=True, compact_tables=True, extract_metadata=False)
    return html_to_markdown.convert(bytes(entry.get_item().content).decode(errors="ignore"), options).content


def sections(lines):
    """Yields (start, end, level, title) for each heading, end including subsections."""
    headings, fence = [], False
    for i, line in enumerate(lines):
        if line.startswith(("```", "~~~")):
            fence = not fence
        elif not fence and (m := re.match(r"(#+) (.+)", line)):
            headings.append((i, len(m[1]), m[2].strip()))
    for k, (start, level, title) in enumerate(headings):
        end = next((i for i, l, _ in headings[k + 1:] if l <= level), len(lines))
        yield start, end, level, title


def outline(ref):
    lines = markdown(ref).splitlines()
    for start, end, level, title in sections(lines):
        print(f"{'  ' * (level - 1)}{title}  ({len(''.join(lines[start:end])):,} chars)")


def get(ref, section=None):
    md = markdown(ref)
    if section is None:
        print(md)
        return
    lines = md.splitlines()
    want = section.lower()
    candidates = [s for s in sections(lines) if want in s[3].lower()]
    match = min(candidates, key=lambda s: (s[3].lower() != want, not s[3].lower().startswith(want), len(s[3])), default=None)
    if match is None:
        sys.exit(f"no section matching {section!r}, see: wiki outline {ref}")
    print("\n".join(lines[match[0]:match[1]]))


def targets(archive, entry):
    """The articles an entry links to, in page order."""
    base = posixpath.dirname(entry.path)
    seen, found = set(), {}
    for href in re.findall(r'href="([^"]+)"', bytes(entry.get_item().content).decode(errors="ignore")):
        href = unquote(html.unescape(href).split("#")[0].split("?")[0])
        if not href or href.startswith("/") or re.match(r"[a-z][a-z0-9+.-]*:", href):
            continue
        path = posixpath.normpath(posixpath.join(base, href))
        if path in seen:
            continue
        seen.add(path)
        try:
            target = resolve(archive.get_entry_by_path(path))
        except KeyError:
            continue
        if target.path != entry.path and target.get_item().mimetype.startswith("text/html"):
            found.setdefault(target.path, target)
    return list(found.values())


def refs(ref):
    name, archive, entry = lookup(ref)
    for t in targets(archive, entry):
        print(f"{name}/{t.path}  {t.title}")


def index_path(zim):
    return Path(f"{zim}.refs.sqlite")


def build_path(zim):
    return Path(f"{zim}.refs.build.sqlite")


# The index has one row per linked-to article: its entry id, and the sorted ids of the articles that link to it,
# stored as the first id and then the gaps between ids, each as a varint.
def pack(ids):
    out, last = bytearray(), 0
    for i in ids:
        gap, last = i - last, i
        while gap > 0x7F:
            out.append(gap & 0x7F | 0x80)
            gap >>= 7
        out.append(gap)
    return bytes(out)


def unpack(blob):
    ids, n, shift, last = [], 0, 0, 0
    for byte in blob:
        n |= (byte & 0x7F) << shift
        if byte & 0x80:
            shift += 7
        else:
            last += n
            ids.append(last)
            n = shift = 0
    return ids


# The build splits the archive into blocks of entries, in libzim's efficient order, and buckets links by target id.
# Finished blocks and buckets are saved as they go, so an interrupted build continues where it stopped.
BLOCK = 10_000
BUCKETS = 256


def index_worker(zim, worker, workers, done, queue):
    """Sends (block, articles, {bucket: packed target<<32|source pairs}) for its share of the blocks, then None."""
    from array import array

    signal.signal(signal.SIGINT, signal.SIG_IGN)
    archive = open_archive(Path(zim))
    # link targets repeat a lot, and every uncached lookup reads the file, which slows down with more processes
    archive.dirent_cache_max_size = 2_000_000
    block, spill, articles = -1, None, 0
    for i, entry in enumerate(archive.iter_efficient()):
        if i // BLOCK != block:
            if spill is not None:
                queue.put((block, articles, {b: pairs.tobytes() for b, pairs in spill.items()}))
            block, articles = i // BLOCK, 0
            spill = {} if block % workers == worker and block not in done else None
        if spill is None or entry.is_redirect or not entry.get_item().mimetype.startswith("text/html"):
            continue
        articles += 1
        for target in targets(archive, entry):
            bucket = target._index * BUCKETS // archive.all_entry_count
            spill.setdefault(bucket, array("Q")).append(target._index << 32 | entry._index)
    if spill is not None:
        queue.put((block, articles, {b: pairs.tobytes() for b, pairs in spill.items()}))
    queue.put(None)


def indexed(zim):
    """Whether zim has a finished index in the current format."""
    import sqlite3

    if not index_path(zim).exists():
        return False
    try:
        sqlite3.connect(f"file:{index_path(zim)}?mode=ro", uri=True).execute("select srcs from refs limit 0")
        return True
    except sqlite3.OperationalError:
        return False


def index_all():
    todo = [name for name, path in wikis().items() if not indexed(path)]
    for name in todo:
        index(name)
    if not todo:
        print("all wikis are indexed")


def index(wiki):
    import multiprocessing
    import queue
    import sqlite3
    from array import array

    name, archive = find(wiki)
    if indexed(archive.filename):
        print(f"{name} is already indexed", flush=True)
        return
    build = build_path(archive.filename)
    db = sqlite3.connect(build)
    db.executescript("""
        create table if not exists blocks (block integer primary key, articles integer);
        create table if not exists spill (bucket integer, pairs blob);
        create index if not exists spill_bucket on spill (bucket);
        create table if not exists buckets (bucket integer primary key);
        create table if not exists refs (dst integer primary key, srcs blob);
    """)
    start = time.time()

    blocks = -(-archive.entry_count // BLOCK)
    done = {b for (b,) in db.execute("select block from blocks")}
    if len(done) < blocks:
        # more than about 4 workers slows down, since they compete for reads of the same file
        workers = max(1, min(4, (os.cpu_count() or 2) - 1, blocks))
        print(f"scanning {name}: {len(done):,} of {blocks:,} blocks done, {workers} workers", file=sys.stderr)
        context = multiprocessing.get_context("spawn")
        results = context.Queue(maxsize=workers * 2)
        procs = [context.Process(target=index_worker, args=(str(archive.filename), w, workers, done, results))
                 for w in range(workers)]
        for p in procs:
            p.start()
        running, scanned, times = workers, 0, []
        try:
            while running:
                try:
                    result = results.get(timeout=5)
                except queue.Empty:
                    if any(p.exitcode not in (None, 0) for p in procs):
                        raise SystemExit(f"an index worker failed, run wiki index {wiki} again to continue")
                    continue
                if result is None:
                    running -= 1
                    continue
                block, articles, spill = result
                with db:
                    db.executemany("insert into spill values (?, ?)", spill.items())
                    db.execute("insert into blocks values (?, ?)", (block, articles))
                done.add(block)
                scanned += 1
                times.append(time.time())
                if scanned % 20 == 0 or len(done) == blocks:
                    elapsed = time.time() - start
                    # blocks vary a lot, e.g. Wikipedia's first half is mostly redirects, so use the recent rate
                    recent = times[-100:]
                    rate = (len(recent) - 1) / (recent[-1] - recent[0]) if len(recent) > 1 and recent[-1] > recent[0] else 0
                    left = (blocks - len(done)) / rate if rate else 0
                    left = f"{left / 60:.0f}m" if left >= 60 else f"{left:.0f}s"
                    print(f"{len(done):,} of {blocks:,} blocks, {elapsed:.0f}s, about {left} left", file=sys.stderr)
        except (KeyboardInterrupt, SystemExit) as e:
            for p in procs:
                p.terminate()
            sys.exit(e.code if isinstance(e, SystemExit) else f"stopped, run wiki index {wiki} again to continue")
        for p in procs:
            p.join()

    packed = {b for (b,) in db.execute("select bucket from buckets")}
    for bucket in range(BUCKETS):
        if bucket in packed:
            continue
        pairs = array("Q")
        for (blob,) in db.execute("select pairs from spill where bucket = ?", (bucket,)):
            pairs.frombytes(blob)
        rows, dst, srcs = [], None, []
        for pair in sorted(pairs):
            if pair >> 32 != dst:
                if srcs:
                    rows.append((dst, pack(srcs)))
                dst, srcs = pair >> 32, []
            srcs.append(pair & 0xFFFFFFFF)
        if srcs:
            rows.append((dst, pack(srcs)))
        with db:
            db.executemany("insert into refs values (?, ?)", rows)
            db.execute("delete from spill where bucket = ?", (bucket,))
            db.execute("insert into buckets values (?)", (bucket,))
        if bucket % 32 == 31:
            print(f"packed {bucket + 1} of {BUCKETS} buckets, {time.time() - start:.0f}s", file=sys.stderr)

    articles = db.execute("select sum(articles) from blocks").fetchone()[0] or 0
    targets_count = db.execute("select count(*) from refs").fetchone()[0]
    db.executescript("drop table spill; drop table buckets; drop table blocks;")
    db.execute("vacuum")
    db.close()
    path = build.rename(index_path(archive.filename))
    print(f"{articles:,} articles, {targets_count:,} linked-to articles, {path.stat().st_size / 1e6:.0f}MB at {path.name}, {time.time() - start:.0f}s", flush=True)


def backrefs(ref, n):
    import sqlite3

    name, archive, entry = lookup(ref)
    path = index_path(archive.filename)
    if not path.exists():
        sys.exit(f"no index for {name}, build it with: wiki index {name}")
    try:
        row = sqlite3.connect(path).execute("select srcs from refs where dst = ?", (entry._index,)).fetchone()
    except sqlite3.OperationalError:
        sys.exit(f"the index for {name} is in an old format, rebuild it with: wiki index {name}")
    srcs = unpack(row[0]) if row else []
    print(f"{len(srcs):,} articles link to {name}/{entry.path}")
    for src in srcs[:n]:
        e = archive.get_entry_by_id(src)
        print(f"{name}/{e.path}  {e.title}")


def open_in_kiwix(ref):
    if "/" in ref:
        _, archive, entry = lookup(ref)
        url = f"zim://{archive.uuid}/{quote(entry.path)}"
    else:
        url = str(find(ref)[1].filename)
    subprocess.run(["open", "-a", "Kiwix", url], check=True)


def main(args):
    n = None
    numbered = [i for i, a in enumerate(args[:-1]) if a == "-n" and args[i + 1].isdigit()]
    if numbered:
        i = numbered[-1]
        n = int(args[i + 1])
        args = args[:i] + args[i + 2:]
    match args:
        case ["install"]:
            install()
        case ["skill"]:
            skill()
        case ["skill", skills]:
            skill(skills)
        case ["update"]:
            update()
        case ["update", "--check"]:
            update(check=True)
        case ["sources"]:
            sources()
        case ["list"]:
            for name, path in wikis().items():
                if archive := open_archive(path):
                    print(f"{name}  {archive.entry_count:,} entries  {path.name}")
        case ["search", *rest] if rest:
            search(" ".join(rest), n or 10)
        case ["outline", ref]:
            outline(ref)
        case ["get", ref]:
            get(ref)
        case ["get", ref, *section] if section:
            get(ref, " ".join(section))
        case ["open", ref]:
            open_in_kiwix(ref)
        case ["refs", ref]:
            refs(ref)
        case ["_refs", ref]:
            backrefs(ref, n or 50)
        case ["index"]:
            index_all()
        case ["index", name]:
            index(name)
        case _:
            sys.exit(__doc__)


# A background server keeps archives open between calls, since opening Wikipedia alone takes ~300ms.
SERVED = {"list", "search", "outline", "get", "refs", "_refs"}
SOCKET = Path(tempfile.gettempdir()) / f"wiki-{hashlib.sha1(str(ROOT).encode()).hexdigest()[:8]}.sock"
VERSION = Path(__file__).stat().st_mtime_ns
IDLE = 30 * 60


def read_all(conn):
    chunks = []
    while chunk := conn.recv(1 << 16):
        chunks.append(chunk)
    return b"".join(chunks)


def serve():
    signal.signal(signal.SIGPIPE, signal.SIG_IGN)
    SOCKET.unlink(missing_ok=True)
    server = socket.socket(socket.AF_UNIX)
    server.bind(str(SOCKET))
    os.chmod(SOCKET, 0o600)
    server.listen()
    server.settimeout(IDLE)
    try:
        while True:
            try:
                conn, _ = server.accept()
            except TimeoutError:
                return
            with conn:
                request = json.loads(read_all(conn))
                if request["version"] != VERSION:
                    conn.sendall(b'{"stale": true}')
                    return
                for path in [p for p in ARCHIVES if not p.exists()]:
                    del ARCHIVES[path]
                out, err, code = io.StringIO(), io.StringIO(), 0
                with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
                    try:
                        main(request["args"])
                    except SystemExit as e:
                        code = e.code if isinstance(e.code, int) else 1
                        if isinstance(e.code, str):
                            print(e.code, file=sys.stderr)
                    except Exception:
                        traceback.print_exc()
                        code = 1
                with contextlib.suppress(OSError):
                    conn.sendall(json.dumps({"out": out.getvalue(), "err": err.getvalue(), "code": code}).encode())
    finally:
        SOCKET.unlink(missing_ok=True)


def via_server(args):
    """Runs args in the server and exits, or starts a server and returns, so args run here this time."""
    try:
        with socket.socket(socket.AF_UNIX) as conn:
            conn.connect(str(SOCKET))
            conn.sendall(json.dumps({"args": args, "version": VERSION}).encode())
            conn.shutdown(socket.SHUT_WR)
            reply = json.loads(read_all(conn))
    except (OSError, ValueError):
        reply = {"stale": True}
    if reply.get("stale"):
        subprocess.Popen([sys.executable, __file__, "_serve"], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    sys.stdout.write(reply["out"])
    sys.stderr.write(reply["err"])
    sys.exit(reply["code"])


# index workers are spawned processes that import this file, so only run commands when it's the main script
if __name__ == "__main__":
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    # search keeps every wiki open, and macOS shells default to 256 open files
    soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
    resource.setrlimit(resource.RLIMIT_NOFILE, (max(soft, min(hard, 10240)), hard))
    args = sys.argv[1:]
    if args == ["_serve"]:
        serve()
    else:
        if args[:1] and args[0] in SERVED:
            via_server(args)
        main(args)
