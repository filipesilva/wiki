#!/usr/bin/env -S uv run --quiet --script
# /// script
# dependencies = ["libzim"]
# ///
"""Search and read the local ZIM wikis.

wiki list                         list wikis
wiki search <query> [-n N]        exact title matches, then ranked full-text search across all wikis, N hits (default 10)
                                  in:<prefix> in the query limits it to wikis whose name starts with prefix
wiki outline <wiki>/<path>        print an article's headings, with the size of each section
wiki get <wiki>/<path> [section]  print an article, or one section of it, as markdown
wiki refs <wiki>/<path>           print the articles it links to
wiki _refs <wiki>/<path> [-n N]   print the articles that link to it, N of them (default 50), needs wiki index
wiki index <wiki>                 build the index for _refs
"""
import html
import posixpath
import re
import signal
import sqlite3
import subprocess
import sys
import time
from pathlib import Path
from urllib.parse import unquote

from libzim.reader import Archive
from libzim.search import Query, Searcher

ROOT = Path(__file__).resolve().parent.parent


def aliases():
    """(regex, alias) for each wikis.txt line with a short name in its second column."""
    path = ROOT / "wikis.txt"
    rules = []
    for line in path.read_text().splitlines() if path.exists() else []:
        if len(parts := line.split()) == 2 and not line.lstrip().startswith("#"):
            rules.append((re.compile(re.escape(parts[0]).replace(r"\*", "(.*)") + "$"), parts[1]))
    return rules


def short_name(full, rules):
    for regex, alias in rules:
        if m := regex.match(full):
            return alias.replace("*", m[1]) if m.groups() else alias
    return full


def wikis():
    """Archives by short name from wikis.txt, or by full name, e.g. wiktionary_en_all_nopic."""
    rules, found = aliases(), {}
    for p in sorted((ROOT / "zim").glob("*.zim")):
        name = short_name(p.stem.rsplit("_", 1)[0], rules)
        if name in found:
            sys.exit(f"{name} is the short name of {Path(found[name].filename).name} and {p.name}, fix wikis.txt")
        try:
            found[name] = Archive(p)
        except RuntimeError as e:
            print(f"skipping {p.name}: {e}", file=sys.stderr)
    return found


def lookup(ref):
    """(wiki, archive, entry) for a <wiki>/<path> ref, with the wiki as a short or full name."""
    name, path = ref.split("/", 1)
    found = wikis()
    if name not in found:
        name = next((n for n, a in found.items() if Path(a.filename).stem.rsplit("_", 1)[0] == name), None)
        if name is None:
            sys.exit(f"no wiki named {ref.split('/', 1)[0]}, see: wiki list")
    archive = found[name]
    if not archive.has_entry_by_path(path):
        sys.exit(f"no article {path} in {name}")
    return name, archive, resolve(archive.get_entry_by_path(path))


def resolve(entry):
    while entry.is_redirect:
        entry = entry.get_redirect_entry()
    return entry


def text(fragment):
    return re.sub(r"\s+", " ", html.unescape(re.sub(r"<[^>]+>", "", fragment))).strip()


def first_sentence(entry):
    for p in re.findall(r"<p[^>]*>(.*?)</p>", bytes(entry.get_item().content).decode(errors="ignore"), re.S):
        if len(p := text(p)) > 20:
            m = re.match(r"(.{20,}?[.!?])(\s|$)", p)
            return (m[1] if m else p)[:300]
    return ""


def search(query, n):
    words = query.split()
    scopes = [w[3:] for w in words if w.startswith("in:")]
    q = " ".join(w for w in words if not w.startswith("in:"))
    scoped = {
        name: a for name, a in wikis().items()
        if not scopes or any(n.startswith(s) for s in scopes for n in (name, Path(a.filename).stem.rsplit("_", 1)[0]))
    }
    if not scoped:
        sys.exit(f"no wikis match {' '.join('in:' + s for s in scopes)}")

    hits = []
    for name, a in scoped.items():
        for title in dict.fromkeys([q, q[:1].upper() + q[1:], q.lower()]):
            if a.has_entry_by_title(title):
                entry = resolve(a.get_entry_by_title(title))
                hits.append((name, entry.path, entry.title, first_sentence(entry)))
                break

    seen = {(name, path) for name, path, _, _ in hits}
    names = {a.filename: name for name, a in scoped.items() if a.has_fulltext_index}
    if names:
        results = Searcher(*(scoped[name] for name in names.values())).search(Query().set_query(q))
        start = 0
        while len(hits) < n and (batch := list(results.get_results(start, n))):
            start += len(batch)
            for r in batch:
                key = (names[r.archive.filename], r.path)
                if r.path.startswith("Category:") or key in seen or len(hits) == n:
                    continue
                seen.add(key)
                hits.append((*key, r.title, text(r.snippet)))

    for name, path, title, snippet in hits[:n]:
        print(f"{name}/{path}  {title}\n  {snippet}")


def markdown(ref):
    _, _, entry = lookup(ref)
    return subprocess.run(
        ["pandoc", "-f", "html", "-t", "gfm-raw_html", "--wrap=none", f"--lua-filter={ROOT / 'lib/strip.lua'}"],
        input=bytes(entry.get_item().content), capture_output=True, check=True,
    ).stdout.decode()


def sections(lines):
    """Yields (start, end, level, title) for each heading, end including subsections."""
    headings, fence = [], False
    for i, line in enumerate(lines):
        if line.startswith(("```", "~~~")):
            fence = not fence
        elif not fence and (m := re.match(r"(#+) (.+)", line)):
            headings.append((i, len(m[1]), m[2].strip()))
    for k, (start, level, title) in enumerate(headings):
        end = next((i for i, l, _ in headings[k + 1:] if l <= level), len(lines))
        yield start, end, level, title


def outline(ref):
    lines = markdown(ref).splitlines()
    for start, end, level, title in sections(lines):
        print(f"{'  ' * (level - 1)}{title}  ({len(''.join(lines[start:end])):,} chars)")


def get(ref, section=None):
    md = markdown(ref)
    if section is None:
        print(md)
        return
    lines = md.splitlines()
    want = section.lower()
    candidates = [s for s in sections(lines) if want in s[3].lower()]
    match = min(candidates, key=lambda s: (s[3].lower() != want, not s[3].lower().startswith(want), len(s[3])), default=None)
    if match is None:
        sys.exit(f"no section matching {section!r}, see: wiki outline {ref}")
    print("\n".join(lines[match[0]:match[1]]))


def targets(archive, entry):
    """The articles an entry links to, in page order."""
    base = posixpath.dirname(entry.path)
    found = {}
    for href in re.findall(r'href="([^"]+)"', bytes(entry.get_item().content).decode(errors="ignore")):
        href = unquote(html.unescape(href).split("#")[0].split("?")[0])
        if not href or href.startswith("/") or re.match(r"[a-z][a-z0-9+.-]*:", href):
            continue
        path = posixpath.normpath(posixpath.join(base, href))
        if path in found or not archive.has_entry_by_path(path):
            continue
        target = resolve(archive.get_entry_by_path(path))
        found[path] = target if target.path != entry.path and target.get_item().mimetype.startswith("text/html") else None
    return list({t.path: t for t in found.values() if t}.values())


def refs(ref):
    name, archive, entry = lookup(ref)
    for t in targets(archive, entry):
        print(f"{name}/{t.path}  {t.title}")


def index_path(archive):
    return Path(f"{archive.filename}.refs.sqlite")


def index(name):
    found = wikis()
    if name not in found:
        sys.exit(f"no wiki named {name}, see: wiki list")
    archive = found[name]
    path = index_path(archive)
    tmp = path.with_suffix(".tmp")
    tmp.unlink(missing_ok=True)
    db = sqlite3.connect(tmp)
    db.executescript("pragma journal_mode=off; pragma synchronous=off;"
                     "create table refs (src integer, dst integer, primary key (dst, src)) without rowid;")
    start, done = time.time(), 0
    for entry in archive.iter_efficient():
        if entry.is_redirect or not entry.get_item().mimetype.startswith("text/html"):
            continue
        db.executemany("insert or ignore into refs values (?, ?)", ((entry._index, t._index) for t in targets(archive, entry)))
        done += 1
        if done % 50_000 == 0:
            print(f"{done:,} articles, {time.time() - start:.0f}s", file=sys.stderr)
    db.commit()
    db.close()
    tmp.rename(path)
    print(f"{done:,} articles in {time.time() - start:.0f}s, {path.stat().st_size / 1e6:.0f}MB at {path.name}")


def backrefs(ref, n):
    name, archive, entry = lookup(ref)
    path = index_path(archive)
    if not path.exists():
        sys.exit(f"no index for {name}, build it with: wiki index {name}")
    db = sqlite3.connect(path)
    total = db.execute("select count(*) from refs where dst = ?", (entry._index,)).fetchone()[0]
    print(f"{total:,} articles link to {name}/{entry.path}")
    for (src,) in db.execute("select src from refs where dst = ? limit ?", (entry._index, n)):
        e = archive.get_entry_by_id(src)
        print(f"{name}/{e.path}  {e.title}")


def main(args):
    n = None
    if "-n" in args:
        i = args.index("-n")
        n = int(args[i + 1])
        args = args[:i] + args[i + 2:]
    match args:
        case ["list"]:
            for name, archive in wikis().items():
                print(f"{name}  {archive.entry_count:,} entries  {Path(archive.filename).name}")
        case ["search", *rest] if rest:
            search(" ".join(rest), n or 10)
        case ["outline", ref]:
            outline(ref)
        case ["get", ref]:
            get(ref)
        case ["get", ref, *section] if section:
            get(ref, " ".join(section))
        case ["refs", ref]:
            refs(ref)
        case ["_refs", ref]:
            backrefs(ref, n or 50)
        case ["index", name]:
            index(name)
        case _:
            sys.exit(__doc__)


signal.signal(signal.SIGPIPE, signal.SIG_DFL)
main(sys.argv[1:])
