#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

base=https://download.kiwix.org/zim
mkdir -p zim

grep -vE '^\s*(#|$)' wikis.txt | while read -r dir name; do
  latest=$(curl -fsL --max-time 60 "$base/$dir/" | grep -oE "\"${name}_[0-9]{4}-[0-9]{2}\.zim\"" | tr -d '"' | sort | tail -1)
  [ -n "$latest" ] || { echo "no build found for $name" >&2; exit 1; }

  if [ -f "zim/$latest" ]; then
    echo "$latest is up to date"
    continue
  fi

  echo "downloading $latest"
  curl -fL -# -C - -o "zim/$latest.part" "$base/$dir/$latest"
  mv "zim/$latest.part" "zim/$latest"
  find zim -name "${name}_*.zim" ! -name "$latest" -print -delete
done
