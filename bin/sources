#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

base=https://download.kiwix.org/zim
# $base itself isn't a file listing, so the folders are listed here.
folders=(wikipedia wiktionary wikibooks wikiquote wikivoyage wikisource wikiversity gutenberg stack_exchange devdocs freecodecamp ifixit libretexts other ted mooc phet zimit vikidia videos)

{
  echo "# <zim name prefix> <kiwix folder>, generated by bin/sources"
  for dir in "${folders[@]}"; do
    curl -fsL --max-time 60 "$base/$dir/" | grep -oE 'href="[^"/?]+\.zim"' | sed -E 's/href="//; s/_.*//' | sort -u | sed "s|\$| $dir|"
  done
} > sources.txt

wc -l < sources.txt
